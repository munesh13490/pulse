{
  "Hosting": {
    "Provider": "Local"
  },
  "Identity": {
    "Provider": "Local"
  },
  "Secrets": {
    "Provider": "Environment"
  },
  "RateLimiting": {
    "RequestProvider": "InMemory",
    "EventProvider": "InMemory",
    "RequestMiddlewareEnabled": true,
    "RequestsPerMinute": 100,
    "EventsPerMinute": 10000
  },
  "Notifications": {
    "Provider": "PostgreSQLPolling"
  },
  "Database": {
    "Provider": "PostgreSQL"
  },
  "Observability": {
    "Provider": "OpenTelemetry"
  }
}
